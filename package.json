{
  "name": "roomcast",
  "version": "0.1.0",
  "description": "Lightweight WebSocket room relay built on Cloudflare Workers + Durable Objects.",
  "type": "module",
  "license": "Apache-2.0",
  "author": {
    "name": "abcamus",
    "url": "https://github.com/abcamus"
  },
  "homepage": "https://github.com/abcamus/roomcast#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/abcamus/roomcast.git"
  },
  "bugs": {
    "url": "https://github.com/abcamus/roomcast/issues"
  },
  "keywords": [
    "cloudflare",
    "cloudflare-workers",
    "durable-objects",
    "websocket",
    "ws",
    "relay",
    "realtime",
    "rooms",
    "p2p",
    "edge",
    "typescript"
  ],
  "engines": {
    "node": ">=18"
  },
  "files": [
    "src",
    "wrangler.toml",
    "LICENSE",
    "README.md",
    "CHANGELOG.md",
    ".npmignore"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --ext .ts",
    "format": "prettier --write \"src/**/*.ts\"",
    "release": "npm run typecheck && npm run lint"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260501.0",
    "@types/node": "^20.11.0",
    "typescript": "^5.8.3",
    "wrangler": "^4.90.0"
  }
}
